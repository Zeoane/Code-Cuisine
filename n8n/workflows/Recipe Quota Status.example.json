    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst SERVICE_ACCOUNT_EMAIL = $json.serviceAccountEmail;\nconst rawKeyBlob = $json.serviceAccountPrivateKey;\n\nfunction normalizePemKey(blob) {\n  const match = blob.match(/BEGIN (?:RSA )?PRIVATE KEY-{2,}([\\s\\S]*?)-{2,}END (?:RSA )?PRIVATE KEY/);\n  if (!match) {\n    throw new Error('Could not find BEGIN/END PRIVATE KEY markers - check the Set node field value.');\n  }\n  const cleaned = match[1].replace(/\\\\n/g, '\\n');\n  const base64 = cleaned.replace(/[^A-Za-z0-9+/=]/g, '');\n  const lines = base64.match(/.{1,64}/g) || [];\n  return '-----BEGIN PRIVATE KEY-----\\n' + lines.join('\\n') + '\\n-----END PRIVATE KEY-----\\n';\n}\n\nconst PRIVATE_KEY = normalizePemKey(rawKeyBlob);\n\nfunction base64url(input) {\n  return Buffer.from(input).toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\n}\n\nconst now = Math.floor(Date.now() / 1000);\nconst header = { alg: 'RS256', typ: 'JWT' };\nconst payload = {\n  iss: SERVICE_ACCOUNT_EMAIL,\n  scope: 'https://www.googleapis.com/auth/datastore',\n  aud: 'https://oauth2.googleapis.com/token',\n  iat: now,\n  exp: now + 3600,\n};\n\nconst unsigned = base64url(JSON.stringify(header)) + '.' + base64url(JSON.stringify(payload));\nconst signer = crypto.createSign('RSA-SHA256');\nsigner.update(unsigned);\nsigner.end();\nconst signature = signer.sign(PRIVATE_KEY).toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\n\nreturn [{\n  json: Object.assign({}, $json, {\n    firestoreJwt: unsigned + '.' + signature,\n  })\n}];"
      },
