    {
      "parameters": {
        "jsCode": "function extractCount(doc) {\n  if (!doc || !doc.fields || !doc.fields.count) return 0;\n  return Number(doc.fields.count.integerValue || 0);\n}\n\nconst ipDoc = $node[\"Read IP Quota Counter\"].json;\nconst totalDoc = $node[\"Read Global Quota Counter\"].json;\nconst ipCount = extractCount(ipDoc);\nconst totalCount = extractCount(totalDoc);\n\nreturn [{\n  json: {\n    ipRemaining: Math.max(0, 3 - ipCount),\n    totalRemaining: Math.max(0, 12 - totalCount),\n  }\n}];"
      },
