# Code à Cuisine – Angular Single Page App auf einem Apache-Server.
#
# Angular kennt Routen wie /library/5 nur im Browser. Ruft jemand so eine
# Adresse direkt auf oder lädt die Seite neu, sucht Apache eine Datei dieses
# Namens und antwortet mit 404. Diese Regel liefert in dem Fall die
# index.html aus; den Rest übernimmt der Router im Browser.
RewriteEngine On
RewriteBase /

# Vorhandene Dateien und Ordner (JS, CSS, Bilder) werden normal ausgeliefert.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Alles andere geht an die App.
RewriteRule ^ index.html [L]

# Die Dateinamen der Bundles enthalten einen Hash, sie dürfen lange im Cache
# bleiben. Die index.html darf es nicht, sonst sieht niemand ein Update.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
